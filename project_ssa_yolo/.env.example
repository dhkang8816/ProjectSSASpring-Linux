FLASK_APP=apps.app:create_app("local")
FLASK_ENV=production

FLASK_DEBUG=0

# Generate separate high-entropy values for each deployment. Do not commit .env.
SSA_FLASK_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
SSA_FLASK_CSRF_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
# Required only when the Spring administrator sidebar controls this local runtime.
SSA_FLASK_CONTROL_TOKEN=CHANGE_ME_TO_A_SEPARATE_RANDOM_TOKEN

DISCORD_WEBHOOK_URL=YOUR_DISCORD_URL

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_RUN_EXTRA_ARGS=--with-threads --no-reload
SSA_ESP32_COM_PORT=COM6
SSA_ESP32_STREAM_URL=http://192.168.0.100:80/stream
SSA_ESP32_HTTP_CONNECT_TIMEOUT_SECONDS=5
SSA_ESP32_HTTP_READ_TIMEOUT_SECONDS=2
SSA_ESP32_MJPEG_BUFFER_MAX_BYTES=4194304
SSA_ESP32_RECONNECT_INITIAL_SECONDS=1
SSA_ESP32_RECONNECT_MAX_SECONDS=5

# These files must already exist. No model/video/production DB defaults are guessed.
# Relative file paths are resolved from the repository root, not this module.
# Shell/service variables override this file. Leave runtime roots blank for OS defaults.
SSA_UPLOAD_ROOT=
SSA_YOLO_MODEL_PATH=
SSA_SQLITE_PATH=
SSA_VIDEO_1_PATH=
SSA_VIDEO_2_PATH=
SSA_VIDEO_3_PATH=
SSA_DEFAULT_VIDEO_SOURCE=video_1

SSA_BATTERY_ENABLED=true
SSA_BATTERY_SOURCE_KEY=esp32
SSA_BATTERY_ADC_PIN=2
SSA_BATTERY_ADC_REFERENCE_VOLTAGE=1.0
SSA_BATTERY_MIN_VOLTAGE=3.0
SSA_BATTERY_MAX_VOLTAGE=4.25
SSA_BATTERY_DIVIDER_RATIO=5.02
SSA_BATTERY_CALIBRATION=0.96
SSA_BATTERY_SAMPLE_COUNT=8
SSA_BATTERY_LOW_PERCENT=25
SSA_BATTERY_CRITICAL_PERCENT=10
SSA_BATTERY_MOCK_ENABLED=false
SSA_BATTERY_MOCK_PERCENT=80
SSA_BATTERY_DEBUG=false
SSA_BATTERY_DEBUG_INTERVAL_SECONDS=30

SSA_ANIMAL_TARGET_REFRESH_SECONDS=15

SSA_BUZZER_STARTUP_SOUND_ENABLED=true
SSA_BUZZER_SHUTDOWN_SOUND_ENABLED=true
SSA_BUZZER_SHUTDOWN_SOUND_WAIT_SECONDS=5
